# Local execution defaults
PIPELINE_MODE=all
FULL_DATA=false
INGEST_WORKERS=4
INCREMENTAL_INGEST=true
LOG_LEVEL=INFO
ENABLE_CACHE=true
CACHE_SIZE=100
QUERY_TIMEOUT_SECONDS=5

# SQLite is the default local backend.
DB_BACKEND=sqlite
SQLITE_DB_PATH=outputs/finance.db

# MySQL (install with: python -m pip install -e ".[mysql]")
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DB=smart_finqa

# Optional OpenAI-compatible service
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
EMBEDDING_MODEL=
LLM_TIMEOUT_SECONDS=40
KB_USE_EMBEDDINGS=false

# Local OCR for scanned or text-poor PDF pages. Install with: python -m pip install -e ".[ocr]"
OCR_ENGINE=disabled
OCR_POLICY=financial_pages_and_low_text
OCR_DPI=220
OCR_MIN_PAGE_TEXT_CHARS=40
OCR_MIN_CONFIDENCE=0.5
OCR_MAX_PAGE_PIXELS=40000000

# Local Web application. The unauthenticated API only permits loopback hosts.
SMART_FINQA_BASE_DIR=.
SMART_FINQA_STORAGE_ROOT=outputs/web_storage
# SMART_FINQA_CONFIG=config.example.yaml
